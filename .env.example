# Database Connection URL (PostgreSQL for Render/Production, SQLite for local dev)
# Example PostgreSQL: postgresql://username:password@localhost:5432/resume_scorer?schema=public
# Example SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
AUTH_SECRET="your_secure_auth_secret_here"

# Server Port
PORT=3000

# Google Gemini API Key (Optional: Falls back to Local Deterministic Engine)
GEMINI_API_KEY=
